# Backend LLM configuration.
# FakeAgent demo mode does not require these variables.

LLM_PROVIDER=deepseek
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_API_KEY=your_api_key_here

# Keep embedding model disabled by default for stable classroom demos.
SEMANTIC_GUARD_ENABLED=false

# -----------------------------------------------------------------------------
# AgentGuard MCP + OAuth local competition demo
# -----------------------------------------------------------------------------

AGENTGUARD_MCP_RESOURCE=http://127.0.0.1:8000/mcp
AGENTGUARD_OAUTH_ISSUER=http://127.0.0.1:9000
AGENTGUARD_OAUTH_RESOURCE_METADATA_URL=http://127.0.0.1:8000/.well-known/oauth-protected-resource

# Local demo only. Replace both values with different long random secrets locally.
AGENTGUARD_OAUTH_DEMO_SECRET=replace-with-a-long-random-local-secret
AGENTGUARD_CAPABILITY_SECRET=replace-with-a-different-long-random-secret

AGENTGUARD_OAUTH_DEMO_CLIENT_ID=agentguard-demo-client
AGENTGUARD_OAUTH_DEMO_USER=demo-user

# Optional comma-separated additional origins. localhost and 127.0.0.1 are allowed by default.
AGENTGUARD_MCP_ALLOWED_ORIGINS=
